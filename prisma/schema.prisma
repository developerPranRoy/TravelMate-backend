// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  AGENCY
  ADMIN
}

enum AgencyStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum PackageStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  agency   Agency?
  bookings Booking[]

  @@map("users")
}

model Agency {
  id            String       @id @default(uuid())
  userId        String       @unique
  agencyName    String
  description   String?
  contactNumber String?
  status        AgencyStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  packages TourPackage[]

  @@map("agencies")
}

model Destination {
  id          String   @id @default(uuid())
  name        String
  country     String
  slug        String   @unique
  description String
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packages TourPackage[]

  @@map("destinations")
}

model TourPackage {
  id             String        @id @default(uuid())
  agencyId       String
  destinationId  String
  title          String
  slug           String        @unique
  description    String
  price          Decimal       @db.Decimal(12, 2)
  durationDays   Int
  availableSeats Int
  startDate      DateTime
  endDate        DateTime
  imageUrl       String?
  status         PackageStatus @default(DRAFT)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  agency      Agency      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Restrict)
  bookings    Booking[]

  @@index([destinationId])
  @@index([agencyId])
  @@index([status])
  @@index([startDate])
  @@map("tour_packages")
}

model Booking {
  id               String        @id @default(uuid())
  bookingReference String        @unique
  customerId       String
  packageId        String
  travelerCount    Int
  unitPrice        Decimal       @db.Decimal(12, 2)
  totalPrice       Decimal       @db.Decimal(12, 2)
  status           BookingStatus @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  customer   User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tourPackage TourPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)
  payment    Payment?

  @@index([customerId])
  @@index([packageId])
  @@index([status])
  @@index([createdAt])
  @@map("bookings")
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String        @unique
  amount            Decimal       @db.Decimal(12, 2)
  status            PaymentStatus @default(UNPAID)
  providerReference String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("payments")
}
